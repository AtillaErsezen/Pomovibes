{
  "manifest_version": 3,
  "name": "Pomovibes",
  "version": "1.0.0",
  "description": "A relaxing, aesthetic Pomodoro timer with study tracking and to-do list.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "offscreen"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "dist/index.html",
    "default_title": "Pomovibes"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/content/floatingTimer.js"
      ]
    }
  ],
  "icons": {
    "16": "assets/Pomodoro_Logo_16.png",
    "48": "assets/Pomodoro_Logo_48.png",
    "128": "assets/Pomodoro_Logo_128.png"
  }
}
